---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import LivroCard from "../../components/LivroCard.astro";

const isProd = import.meta.env.PROD;
const livros = (await getCollection("livros", ({ data }) => !(isProd && data.draft)))
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, "pt-BR"));

// Mapa livro -> resenha (para mostrar o selo "ler resenha" só nos livros resenhados)
const resenhas = await getCollection(
  "resenhas",
  ({ data }) => !(isProd && data.draft),
);
const resenhaPorLivro = new Map(resenhas.map((r) => [r.data.livro.id, r.id]));
---

<MainLayout activePage="livros" pageTitle={siteConfig.title + " | Livros"}>
  <div class="page-content py-8">
    <h1 class="sigmar-ff text-center">Livros</h1>
    <p class="kanit-regular text-center mb-8">
      Todos os livros do acervo, em ordem alfabética.
    </p>
    {
      livros.length === 0 ? (
        <p class="font-light text-center">Nenhum livro cadastrado ainda.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {livros.map((livro) => (
            <LivroCard livro={livro} resenhaId={resenhaPorLivro.get(livro.id)} />
          ))}
        </div>
      )
    }
  </div>
</MainLayout>
