---
import "../../styles/global.css";
import {
  type CollectionEntry,
  getCollection,
  render,
} from "astro:content";
import { sortVideosDesc, withBase, youtubeEmbed } from "../../utils/helpers";
import MainLayout from "../../layouts/MainLayout.astro";
import Button from "../../components/Button.astro";
import ArrowLeft from "../../icons/ArrowLeft.astro";
import siteConfig from "../../site.config";

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const videos = (
    await getCollection("videos", ({ data }) => !(isProd && data.draft))
  ).sort(sortVideosDesc);
  return videos.map((video) => ({
    params: { id: video.id },
    props: { video },
  }));
}

type Props = { video: CollectionEntry<"videos"> };
const { video } = Astro.props;
const { Content } = await render(video);

const embed = youtubeEmbed(video.data.youtube);
---

<MainLayout
  activePage="vídeos"
  pageTitle={siteConfig.title + " | " + video.data.titulo}
>
  <div class="page-content py-8">
    <h1 class="sigmar-ff text-center text-balance">{video.data.titulo}</h1>
    {
      video.data.descricao && (
        <p class="kanit-regular text-center mb-6 text-balance">
          {video.data.descricao}
        </p>
      )
    }

    <div
      class="relative aspect-video w-full max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-md mb-8"
    >
      <iframe
        class="absolute inset-0 w-full h-full"
        src={embed}
        title={video.data.titulo}
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>

    <article class="font-light text-left mt-4 max-w-xl mx-auto">
      <Content />
    </article>

    <div class="flex items-center justify-center my-8">
      <Button class="back-link" href={withBase("/videos")}>
        <ArrowLeft class="w-5 h-5 fill-current mr-4" /> Todos os vídeos
      </Button>
    </div>
  </div>
</MainLayout>
