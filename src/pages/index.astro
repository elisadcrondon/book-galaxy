---
import { getCollection, type CollectionEntry } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import { sortResenhasByDateDesc, sortOrbitaDesc, withBase } from "../utils/helpers";
import ResenhaDestaque from "../components/ResenhaDestaque.astro";
import FeedItem from "../components/FeedItem.astro";
import Button from "../components/Button.astro";
import ArrowRight from "../icons/ArrowRight.astro";

const isProd = import.meta.env.PROD;

const resenhas = (await getCollection("resenhas", ({ data }) => !(isProd && data.draft)))
  .sort(sortResenhasByDateDesc);

const orbita = (await getCollection("orbita", ({ data }) => !(isProd && data.draft)))
  .sort(sortOrbitaDesc);

// Estatísticas mostradas discretamente abaixo da apresentação
const totalLivros = (await getCollection("livros")).length;
const totalAutores = (await getCollection("autores")).length;
const totalColecoes = (await getCollection("colecoes")).length;

// As resenhas mais recentes ganham destaque no carrossel do topo
const destaques = resenhas.slice(0, 6);
const idsDestacadas = new Set(destaques.map((r) => r.id));

// Diário: resenhas (sem as destacadas) e órbita misturadas, da mais nova
// para a mais antiga
type FeedEntry =
  | { tipo: "resenha"; entrada: CollectionEntry<"resenhas"> }
  | { tipo: "orbita"; entrada: CollectionEntry<"orbita"> };

const feed: FeedEntry[] = [
  ...resenhas
    .filter((r) => !idsDestacadas.has(r.id))
    .map((entrada) => ({ tipo: "resenha", entrada }) as FeedEntry),
  ...orbita.map((entrada) => ({ tipo: "orbita", entrada }) as FeedEntry),
].sort(
  (a, b) =>
    new Date(b.entrada.data.pubDate).getTime() -
    new Date(a.entrada.data.pubDate).getTime()
);

const feedLimit = 10;
const entradas = feed.slice(0, feedLimit);
---

<MainLayout activePage="home" pageTitle={siteConfig.title}>
  <!-- Hero: apresentação + imagem da Elisa lendo -->
  <div
    class="w-full px-4 mt-10 flex flex-col-reverse sm:flex-row items-center justify-between gap-8"
  >
    <div class="flex-1 max-w-md text-center sm:text-left">
      <p class="kanit-light text-xs tracking-widest uppercase opacity-60 mb-2">
        {siteConfig.hero?.eyebrowText}
      </p>
      <h1 class="sigmar-ff text-3xl sm:text-4xl leading-tight py-0! sm:py-0!">
        {siteConfig.hero?.title}
      </h1>
      <p class="kanit-regular text-sm sm:text-base mt-3 mb-0">
        {siteConfig.hero?.text}
      </p>
      <p class="kanit-light text-xs mt-3 mb-0 opacity-60">
        {resenhas.length} resenhas · {totalLivros} livros · {totalAutores} autores · {totalColecoes} coleções{
          orbita.length > 0 && ` · ${orbita.length} textos na Órbita`
        }
      </p>
    </div>
    <img
      class="w-72 sm:w-80 max-w-full h-auto shrink-0"
      src={withBase("/menina-lendo.png")}
      alt="Menina lendo um livro, cercada por livros e estrelas"
      width={320}
      height={179}
      loading="eager"
    />
  </div>

  <!-- Destaques: carrossel com as resenhas mais recentes -->
  <div class="w-full px-4 mt-12 text-left">
    <div class="flex items-baseline justify-between border-b-2 border-black/20 dark:border-white/20 pb-2">
      <h2 class="sigmar-ff text-xl sm:text-2xl py-0! sm:py-0!">Últimas resenhas</h2>
      <div class="flex items-center gap-4">
        <a
          href={withBase("/resenhas")}
          class="text-xs kanit-bold uppercase tracking-widest hover:text-space-red dark:hover:text-space-yellow"
        >
          Ver todas
        </a>
        <div class="hidden sm:flex items-center gap-2">
          <button
            id="carrossel-ant"
            type="button"
            aria-label="Resenhas anteriores"
            class="cursor-pointer rounded-full border border-black/30 dark:border-white/30 p-1.5 hover:border-space-red hover:text-space-red dark:hover:border-space-yellow dark:hover:text-space-yellow transition-colors"
          >
            <ArrowRight class="w-4 h-4 fill-current rotate-180" />
          </button>
          <button
            id="carrossel-prox"
            type="button"
            aria-label="Próximas resenhas"
            class="cursor-pointer rounded-full border border-black/30 dark:border-white/30 p-1.5 hover:border-space-red hover:text-space-red dark:hover:border-space-yellow dark:hover:text-space-yellow transition-colors"
          >
            <ArrowRight class="w-4 h-4 fill-current" />
          </button>
        </div>
      </div>
    </div>

    <div
      id="carrossel-resenhas"
      class="no-scrollbar flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth mt-8 pb-2"
    >
      {
        destaques.map((resenha, i) => (
          <div class="snap-start shrink-0 w-[70%] sm:w-[calc((100%-3rem)/3)]">
            <ResenhaDestaque resenha={resenha} posicao={i} nova={i === 0} />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Feed: o diário, em ordem cronológica -->
  <div class="w-full px-4 mt-14 text-left">
    <div class="flex items-baseline justify-between border-b-2 border-black/20 dark:border-white/20 pb-2">
      <h2 class="sigmar-ff text-xl sm:text-2xl py-0! sm:py-0!">No diário</h2>
      <a
        href={withBase("/orbita")}
        class="text-xs kanit-bold uppercase tracking-widest hover:text-space-red dark:hover:text-space-yellow"
      >
        Toda a Órbita
      </a>
    </div>

    {
      entradas.length === 0 ? (
        <p class="kanit-light text-center mt-8">
          Ainda não há publicações. Crie a primeira na pasta <code>resenhas</code> ou <code>orbita</code>.
        </p>
      ) : (
        <div class="flex flex-col divide-y divide-black/10 dark:divide-white/10 mt-2">
          {entradas.map(({ tipo, entrada }) =>
            tipo === "resenha" ? (
              <FeedItem tipo="resenha" entrada={entrada} />
            ) : (
              <FeedItem tipo="orbita" entrada={entrada} />
            )
          )}
        </div>
      )
    }

    <div class="flex flex-wrap items-center justify-center gap-4 mt-10">
      <Button href={withBase("/resenhas")} class="space-btn-filled">
        Todas as resenhas <ArrowRight class="w-5 h-5 fill-current ml-4" />
      </Button>
      <Button href={withBase("/orbita")} class="space-btn-outlined">
        Toda a Órbita <ArrowRight class="w-5 h-5 fill-current ml-4" />
      </Button>
    </div>
  </div>

  <script is:inline>
    (() => {
      const trilho = document.querySelector("#carrossel-resenhas");
      const ant = document.querySelector("#carrossel-ant");
      const prox = document.querySelector("#carrossel-prox");
      if (!trilho) return;
      const passo = () => {
        const slide = trilho.querySelector(":scope > div");
        return slide ? slide.getBoundingClientRect().width + 24 : trilho.clientWidth;
      };
      ant?.addEventListener("click", () => trilho.scrollBy({ left: -passo(), behavior: "smooth" }));
      prox?.addEventListener("click", () => trilho.scrollBy({ left: passo(), behavior: "smooth" }));
    })();
  </script>
</MainLayout>
