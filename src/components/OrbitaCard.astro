---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import { excerptFromMarkdown, withBase } from "../utils/helpers";

type Props = { nota: CollectionEntry<"orbita"> };
const { nota } = Astro.props;
const href = withBase("/orbita/" + nota.id);
const trecho = excerptFromMarkdown(nota.body);
---

<article class="rounded-2xl p-6 shadow-md bg-gradient-to-br from-space-red/10 to-space-yellow/10">
  <a href={href} class="group block">
    <h2 class="kanit-bold text-2xl group-hover:underline">{nota.data.titulo}</h2>
  </a>
  <div class="mt-1.5 mb-3 opacity-70">
    <FormattedDate date={new Date(nota.data.pubDate)} />
  </div>
  {
    trecho && (
      <p class="font-light leading-relaxed whitespace-pre-line">{trecho}</p>
    )
  }
  <a
    href={href}
    class="inline-block mt-4 kanit-bold text-space-red dark:text-space-yellow hover:underline"
  >
    Leia tudo →
  </a>
</article>
