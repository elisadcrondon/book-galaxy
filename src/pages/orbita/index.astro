---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import OrbitaCard from "../../components/OrbitaCard.astro";
import { sortOrbitaDesc } from "../../utils/helpers";

const isProd = import.meta.env.PROD;
const notas = (
  await getCollection("orbita", ({ data }) => !(isProd && data.draft))
).sort(sortOrbitaDesc);
---

<MainLayout activePage="órbita" pageTitle={siteConfig.title + " | Órbita"}>
  <div class="page-content py-8">
    <h1 class="sigmar-ff text-center">Órbita</h1>
    <p class="kanit-regular text-center mb-8 text-balance">
      Ideias, anotações, descobertas, amigas... tudo que orbita a minha vida. 🌍✨
    </p>
    {
      notas.length === 0 ? (
        <p class="font-light text-center">Nenhuma anotação publicada ainda.</p>
      ) : (
        <div class="flex flex-col gap-6">
          {notas.map((nota) => <OrbitaCard nota={nota} />)}
        </div>
      )
    }
  </div>
</MainLayout>
