---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import { withBase } from "../../utils/helpers";

const isProd = import.meta.env.PROD;
const autores = (await getCollection("autores", ({ data }) => !(isProd && data.draft)))
  .sort((a, b) => a.data.nome.localeCompare(b.data.nome, "pt-BR"));
const livros = await getCollection("livros", ({ data }) => !(isProd && data.draft));

function contaLivros(autorId: string) {
  return livros.filter((l) => l.data.autores.some((a) => a.id === autorId)).length;
}
---

<MainLayout activePage="autores" pageTitle={siteConfig.title + " | Autores"}>
  <div class="page-content py-8">
    <h1 class="sigmar-ff text-center">Autores</h1>
    <p class="kanit-regular text-center mb-8">
      Selecione um autor para ver os livros dele no acervo.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      {
        autores.map((autor) => (
          <a
            href={withBase("/autores/" + autor.id)}
            class="tag rounded-full px-4 py-1 border border-gray-500 kanit-light hover:border-space-red dark:hover:border-space-yellow transition-colors"
          >
            {autor.data.nome} ({contaLivros(autor.id)})
          </a>
        ))
      }
    </div>
  </div>
</MainLayout>
