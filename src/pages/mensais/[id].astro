---
import "../../styles/global.css";
import {
  type CollectionEntry,
  getCollection,
  getEntries,
  getEntry,
  render,
} from "astro:content";
import { mesPorExtenso, sortMensaisDesc, withBase } from "../../utils/helpers";
import MainLayout from "../../layouts/MainLayout.astro";
import Button from "../../components/Button.astro";
import ArrowLeft from "../../icons/ArrowLeft.astro";
import Capa from "../../components/Capa.astro";
import Idioma from "../../components/Idioma.astro";
import siteConfig from "../../site.config";

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const mensais = (
    await getCollection("mensais", ({ data }) => !(isProd && data.draft))
  ).sort(sortMensaisDesc);
  return mensais.map((mensal) => ({
    params: { id: mensal.id },
    props: { mensal },
  }));
}

type Props = { mensal: CollectionEntry<"mensais"> };
const { mensal } = Astro.props;
const { Content } = await render(mensal);

const titulo =
  mensal.data.titulo ||
  `${mesPorExtenso(mensal.data.mes)} de ${mensal.data.ano}`;

// Livros lidos no mês
const livros = await getEntries(mensal.data.livros);

// Mapa livro -> resenha (para linkar quando já existe resenha completa)
const isProd = import.meta.env.PROD;
const resenhas = await getCollection(
  "resenhas",
  ({ data }) => !(isProd && data.draft),
);
const resenhaPorLivro = new Map(
  resenhas.map((r) => [r.data.livro.id, r.id]),
);
---

<MainLayout
  activePage="mensais"
  pageTitle={siteConfig.title + " | " + titulo}
  description={`Os livros que a Elisa leu em ${titulo}: resenhas e retrospectiva no Book Galaxy.`.slice(
    0,
    160,
  )}
>
  <div class="page-content py-8">
    <h1 class="sigmar-ff text-center">{titulo}</h1>
    <p class="kanit-regular text-center mb-8">
      {
        livros.length === 1
          ? "Um livro neste mês 📖"
          : `${livros.length} livros neste mês 📚`
      }
    </p>

    {
      livros.length > 0 && (
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-4 justify-items-center mb-10">
          {livros.map((livro) => {
            const resenhaId = resenhaPorLivro.get(livro.id);
            const href = resenhaId
              ? withBase("/resenhas/" + resenhaId)
              : withBase("/livros/" + livro.id);
            return (
              <a href={href} class="group flex flex-col items-center text-center">
                <Capa
                  capa={livro.data.capa}
                  titulo={livro.data.titulo}
                  width={110}
                  height={165}
                  class="transition-transform group-hover:-translate-y-1"
                />
                <span class="kanit-regular text-xs mt-2 leading-tight group-hover:underline">
                  {livro.data.titulo}
                </span>
                <span class="flex flex-wrap justify-center gap-1 mt-1.5">
                  <Idioma idioma={livro.data.idioma} />
                  {resenhaId && (
                    <span class="inline-flex items-center gap-1 rounded-full text-xs px-2.5 py-0.5 border border-gray-500 kanit-light">
                      ✍️ Resenha
                    </span>
                  )}
                </span>
              </a>
            );
          })}
        </div>
      )
    }

    <article class="font-light text-left mt-4">
      <Content />
    </article>

    <div class="flex items-center justify-center my-8">
      <Button class="back-link" href={withBase("/mensais")}>
        <ArrowLeft class="w-5 h-5 fill-current mr-4" /> Todos os meses
      </Button>
    </div>
  </div>
</MainLayout>
