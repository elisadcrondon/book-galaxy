---
import "../styles/global.css";

import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Subscribe from "../components/Subscribe.astro";
import { withBase } from "../utils/helpers";
import siteConfig from "../site.config";

type LayoutProps = {
  pageTitle: string;
  activePage: string;
  showSubscribeForm?: boolean;
  description?: string;
  ogImage?: string;
  ogType?: string;
};
const {
  pageTitle,
  activePage,
  showSubscribeForm = true,
  description = siteConfig.description,
  ogImage = siteConfig.image?.src,
  ogType = "website",
} = Astro.props as LayoutProps;

// URL canônica desta página (usa o domínio definido em astro.config -> Astro.site)
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Imagem de preview absoluta para redes sociais
const socialImage = ogImage
  ? new URL(withBase(ogImage), Astro.site)
  : undefined;
---

<!doctype html>
<html lang="pt-BR" class="antialiased break-words light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={withBase(`/space-ahead-logo.png`)} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (Facebook, WhatsApp, etc.) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <link rel="sitemap" href={withBase(`/sitemap-index.xml`)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sigmar&family=Kanit:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.title + " - RSS Feed"}
      href={new URL(withBase("/rss.xml"), Astro.site)}
    />
    <slot name="head" />
  </head>
  <body>
    <main class="max-w-3xl mx-auto min-h-screen">
      <Nav activePage={activePage} />
      <slot />
      {showSubscribeForm && <Subscribe class="my-12 w-full" />}
      <Footer />
    </main>
  </body>
</html>
