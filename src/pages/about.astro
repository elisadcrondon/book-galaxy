---
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import { withBase } from "../utils/helpers";
---

<MainLayout activePage="sobre" pageTitle={siteConfig.title + " | Sobre"}>
  <div class="page-content">
    <h1 class="sigmar-ff text-balance text-center">{siteConfig.about?.title}</h1>
    <img
      width={320}
      height={320}
      loading="eager"
      class="mb-8 mx-auto w-64 sm:w-80 h-auto"
      src={withBase("/elisa.png")}
      alt="Elisa lendo um livro"
    />
    <p class="kanit-light text-left text-balance max-w-xl mx-auto">
      {siteConfig.about?.text}
    </p>
  </div>
</MainLayout>
