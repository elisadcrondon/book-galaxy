---
import { type CollectionEntry, getEntries } from "astro:content";
import { withBase } from "../utils/helpers";
import Capa from "./Capa.astro";
import Idioma from "./Idioma.astro";
import Pill from "./Pill.astro";

type Props = { livro: CollectionEntry<"livros">; resenhaId?: string };
const { livro, resenhaId } = Astro.props;
const { titulo, autores = [], estilos = [], capa, idioma, anoPublicacao } =
  livro.data;

const autoresEntries = await getEntries(autores);
const estilosEntries = await getEntries(estilos);
---

<div class="flex gap-4">
  <div class="shrink-0 flex flex-col items-center gap-1.5">
    <a href={withBase("/livros/" + livro.id)}>
      <Capa capa={capa} titulo={titulo} width={110} height={165} />
    </a>
    <Idioma idioma={idioma} compact />
  </div>
  <div class="flex flex-col gap-1">
    <a href={withBase("/livros/" + livro.id)}>
      <h3 class="sigmar-ff text-base leading-tight">{titulo}</h3>
    </a>
    {
      resenhaId && (
        <a
          class="kanit-bold text-xs hover:underline w-fit"
          href={withBase("/resenhas/" + resenhaId)}
        >
          ✍️ ler resenha →
        </a>
      )
    }
    {
      autoresEntries.length > 0 && (
        <p class="kanit-regular text-xs">
          por{" "}
          {autoresEntries.map((a, i) => (
            <>
              <a
                class="hover:underline"
                href={withBase("/autores/" + a.id)}
              >
                {a.data.nome}
              </a>
              {i < autoresEntries.length - 1 ? ", " : ""}
            </>
          ))}
          {anoPublicacao ? ` · ${anoPublicacao}` : ""}
        </p>
      )
    }
    <div class="flex flex-wrap gap-1.5 mt-1">
      {
        estilosEntries.map((e) => (
          <Pill href={withBase("/estilos/" + e.id)}>
            {e.data.emoji ? e.data.emoji + " " : ""}
            {e.data.nome}
          </Pill>
        ))
      }
    </div>
  </div>
</div>
